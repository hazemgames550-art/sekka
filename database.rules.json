{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[0-9]{4}$/)",
        ".write": "$code.matches(/^[0-9]{4}$/) && (!data.exists() || newData.exists())",
        ".validate": "newData.hasChildren(['host', 'settings', 'gid'])"
      }
    }
  }
}
